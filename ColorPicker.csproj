<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ColorPicker</RootNamespace>
    <IsPackable>true</IsPackable>

    <Authors>Egor Mozgovoy, Krzysztof Krysiński</Authors>
    <Company>PixiEditor</Company>
    <Copyright>PixiEditor</Copyright>
    <Description>Avalonia color picker controls maintained by Froststrap.</Description>
    <PackageId>Froststrap.ColorPicker</PackageId>
    <RepositoryUrl>https://github.com/Froststrap/ColorPicker</RepositoryUrl>
    <Version>1.0.10</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile          Remove="ColorPicker.AvaloniaUI/**" />
    <None             Remove="ColorPicker.AvaloniaUI/**" />
    <AvaloniaResource Remove="ColorPicker.AvaloniaUI/**" />
    <EmbeddedResource Remove="ColorPicker.AvaloniaUI/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Xaml.Behaviors" Version="12.0.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Images\**" />
  </ItemGroup>
</Project>